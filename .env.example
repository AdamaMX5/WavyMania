# WavyMania — shared environment configuration
#
# Copy this file to `.env` in this same directory (repo root) and fill in the
# real values. Both apps/wavy-app and apps/wavy-business read from this one
# file (see each app's vite.config.ts `envDir`) instead of per-app .env files,
# since several services below are used by both frontends.
#
# VITE_-prefixed vars are exposed to client-side code via import.meta.env.
# *_SERVICE_PROXY_TARGET vars are Node-side only (used by vite.config.ts for
# the local dev proxy) and never reach the browser bundle.

# --- All services below are now deployed under stable *.freischule.info
# domains — client code already hardcodes those as its default, so leaving a
# var empty/unset is correct for production. Only set one of these if that
# service's domain changes, OR set it to the matching /api/<service> path
# below to opt into the local dev proxy against a locally-running instance
# (see the *_SERVICE_PROXY_TARGET vars further down) ---
# VITE_WAVE_SERVICE_URL=https://wave.freischule.info
# VITE_GEO_SERVICE_URL=https://geo.freischule.info
# VITE_ACTIVATION_SERVICE_URL=https://activation.freischule.info
# VITE_MARKET_SERVICE_URL=https://market.freischule.info
# VITE_TICKET_SERVICE_URL=https://ticket.freischule.info
# VITE_PAYMENT_SERVICE_URL=https://payment.freischule.info
# VITE_AUTH_SERVICE_URL=https://auth.freischule.info
# VITE_PROFILE_SERVICE_URL=https://profile.freischule.info
# VITE_OBJECT_SERVICE_URL=https://object.freischule.info

# --- WavyBusiness: not a backend service, but a separate app/domain that
# wavy-app links out to (e.g. the "Unternehmerkonto erstellen" CTA on wave
# creation) — same override rationale as above ---
# VITE_WAVY_BUSINESS_URL=https://business.freischule.info

# --- Local dev only: proxy targets for a locally-running service instance,
# used by vite.config.ts's dev-server proxy when the matching VITE_*_URL
# above is explicitly set to /api/<service> (e.g. VITE_MARKET_SERVICE_URL=/api/market) ---
WAVE_SERVICE_PROXY_TARGET=http://localhost:3000
GEO_SERVICE_PROXY_TARGET=http://localhost:3001
ACTIVATION_SERVICE_PROXY_TARGET=http://localhost:3002
MARKET_SERVICE_PROXY_TARGET=http://localhost:3003
TICKET_SERVICE_PROXY_TARGET=http://localhost:3004
PAYMENT_SERVICE_PROXY_TARGET=http://localhost:3005
