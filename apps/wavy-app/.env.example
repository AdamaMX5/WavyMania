# Absolute WaveService URL, e.g. https://wave.wavymania.io.
# Leave unset for local dev — waveClient.ts then calls /api/wave, which
# vite.config.ts proxies to a local WaveService instance (default
# http://localhost:3000, override via WAVE_SERVICE_PROXY_TARGET).
VITE_WAVE_SERVICE_URL=

# Absolute GeoService URL, e.g. https://geo.wavymania.io.
# Leave unset for local dev — geoClient.ts then calls /api/geo, which
# vite.config.ts proxies to a local GeoService instance (default
# http://localhost:3001, override via GEO_SERVICE_PROXY_TARGET).
VITE_GEO_SERVICE_URL=

# Absolute ActivationService URL, e.g. https://activation.wavymania.io.
# Leave unset for local dev — activationClient.ts then calls /api/activation,
# which vite.config.ts proxies to a local ActivationService instance (default
# http://localhost:3002, override via ACTIVATION_SERVICE_PROXY_TARGET).
VITE_ACTIVATION_SERVICE_URL=
