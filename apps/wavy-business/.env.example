# Absolute TicketService URL, e.g. https://ticket.wavymania.io.
# Leave unset for local dev — eventClient.ts then calls /api/ticket, which
# vite.config.ts proxies to a local TicketService instance (default
# http://localhost:3004, override via TICKET_SERVICE_PROXY_TARGET).
VITE_TICKET_SERVICE_URL=

# Absolute MarketService URL, e.g. https://market.wavymania.io.
# Leave unset for local dev — marketClient.ts then calls /api/market, which
# vite.config.ts proxies to a local MarketService instance (default
# http://localhost:3003, override via MARKET_SERVICE_PROXY_TARGET).
VITE_MARKET_SERVICE_URL=
